# Configurações do Servidor Orquestrador
PORT=3001
NODE_ENV=development

# Configurações da WAHA API (WhatsApp HTTP API)
# URL onde a WAHA está rodando (ex: http://localhost:3000 ou https://waha.meudominio.com)
WAHA_BASE_URL=http://localhost:3000
# Sessão do WhatsApp configurada na WAHA (geralmente "default")
WAHA_SESSION=default
# Chave de API da WAHA (deixe em branco se não configurou WAHA_API_KEY)
WAHA_API_KEY=

# Configurações do Google Gemini
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
# Modelo Gemini a ser utilizado (gemini-2.0-flash ou gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Configuração da URL do Orquestrador para registro de Webhook na WAHA
# URL pública do webhook (ex: https://webhook.meudominio.com ou ngrok/cloudflared)
WEBHOOK_PUBLIC_URL=http://localhost:3001

# Integração Opcional com Chatwoot (para sincronia avançada de status de conversa)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
